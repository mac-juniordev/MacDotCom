{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],

    "outDir": "./dist",
    "rootDir": "./",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "typeRoots": ["./node_modules/@types"]
  },

  "include": ["**/*.ts", "**/*.d.ts"],
  "exclude": ["node_modules", "dist", "uploads"]
}